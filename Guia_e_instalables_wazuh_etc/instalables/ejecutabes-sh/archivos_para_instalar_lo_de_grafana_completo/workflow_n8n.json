{
  "name": "Wazuh Emergencias con Groq (10 min + Anti-Duplicados)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "wazuh-alertas",
        "options": {}
      },
      "id": "node-webhook",
      "name": "1. Recibir Alerta Wazuh",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nif (!staticData.alertas) staticData.alertas = [];\n\nconst body = $input.first().json.body || $input.first().json;\nconst agente = body.agent?.name || 'Desconocido';\nconst ip_origen = body.data?.srcip || 'N/A';\nconst descripcion = body.rule?.description || 'Sin descripción';\n\nconst existente = staticData.alertas.find(\n  a => a.agente === agente && a.ip_origen === ip_origen && a.descripcion === descripcion\n);\n\nif (existente) {\n  existente.veces += 1;\n  existente.ultima_fecha = body.timestamp;\n} else {\n  staticData.alertas.push({\n    fecha: body.timestamp,\n    agente,\n    ip_origen,\n    nivel: body.rule?.level,\n    descripcion,\n    veces: 1\n  });\n}\n\nreturn [{ json: { acumulado: staticData.alertas.length } }];"
      },
      "id": "node-cola",
      "name": "2. Guardar en Cola (Anti-Duplicados)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        240
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 10
            }
          ]
        }
      },
      "id": "node-cron",
      "name": "3. Cada 10 Minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        480
      ]
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst pendientes = staticData.alertas || [];\nstaticData.alertas = [];\n\nif (pendientes.length === 0) {\n  return [];\n}\n\nreturn [{ json: { alertas: pendientes, total: pendientes.length } }];"
      },
      "id": "node-extraer",
      "name": "4. Extraer Alertas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        480
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Eres un analista de ciberseguridad SOC. Revisa esta lista de alertas de Wazuh ocurridas en los últimos 10 minutos.\nFiltra únicamente las que representen una EMERGENCIA real o riesgo importante.\nSi ninguna es una emergencia real, responde exactamente y sin nada más: SIN_EMERGENCIAS\n\nSi hay emergencias, redáctalas en español en una lista limpia y clara para enviar por correo electrónico. Para cada una pon:\n- Título corto, equipo afectado y cuántas veces ocurrió (campo 'veces')\n- Descripción básica en 1 o 2 frases sencillas de qué trata el problema\n- IP origen (si hay) y nivel de gravedad\n\nAlertas:\n{{ JSON.stringify($json.alertas) }}"
      },
      "id": "node-llm",
      "name": "5. Analizar con IA",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        720,
        480
      ]
    },
    {
      "parameters": {
        "model": "openai/gpt-oss-120b",
        "options": {}
      },
      "id": "node-groq",
      "name": "Groq Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [
        760,
        700
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{ $json.text.trim() }}",
              "rightValue": "SIN_EMERGENCIAS",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "node-if",
      "name": "6. ¿Es Emergencia?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1040,
        480
      ]
    },
    {
      "parameters": {
        "fromEmail": "botalertas.wazuh@gmail.com",
        "toEmail": "botalertas.wazuh@gmail.com",
        "subject": "🚨 RESUMEN DE EMERGENCIAS WAZUH",
        "emailFormat": "text",
        "text": "={{ $json.text }}"
      },
      "id": "node-email",
      "name": "7. Enviar Correo",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1300,
        460
      ]
    }
  ],
  "connections": {
    "1. Recibir Alerta Wazuh": {
      "main": [
        [
          {
            "node": "2. Guardar en Cola (Anti-Duplicados)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "3. Cada 10 Minutos": {
      "main": [
        [
          {
            "node": "4. Extraer Alertas",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "4. Extraer Alertas": {
      "main": [
        [
          {
            "node": "5. Analizar con IA",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Groq Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "5. Analizar con IA",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "5. Analizar con IA": {
      "main": [
        [
          {
            "node": "6. ¿Es Emergencia?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "6. ¿Es Emergencia?": {
      "main": [
        [
          {
            "node": "7. Enviar Correo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
